# BloodBridge Intelligence Network - Environment Configuration
# Copy this to .env for local development

# ===== Environment =====
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO

# ===== Database (RDS PostgreSQL) =====
DATABASE_URL=postgresql://postgres:PASSWORD@your-rds-host.ap-south-1.rds.amazonaws.com:5432/postgres

# ===== AWS =====
AWS_REGION=ap-south-1
# Your personal/project IAM user — overrides ~/.aws/credentials on your laptop
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=   # only if using temporary credentials

USE_AWS_MOCKS=true
# Real SMS to phone: SNS_USE_MOCKS=false (SageMaker etc. stay mocked)
SNS_USE_MOCKS=false

# ===== SES (Email) =====
SES_SENDER_EMAIL=noreply@bloodbridge.in
SES_SENDER_NAME=Blood Warriors Foundation
# Local dev (click YES/NO in admin UI): http://localhost:5173/respond  (Vite proxies to API)
# Production SMS links: https://your-api-domain.com/respond  (also available at /api/respond)
RESPONSE_BASE_URL=http://localhost:5173/respond

# ===== Outreach (coordinator manual send) =====
# true = no auto-SMS on create; admin clicks "Send SMS to top 2 donors"
MANUAL_OUTREACH=true
OUTREACH_BATCH_SIZE=2
SMS_SEND_DELAY_SECONDS=0.6
# Optional: redirect ALL SMS to your phone (must be verified in AWS SNS sandbox)
# SMS_OVERRIDE_PHONE=+91XXXXXXXXXX
DEMO_DONOR_PHONES=+917386223111,+918247364827

# ===== SNS (SMS) =====
# Real SMS: set USE_AWS_MOCKS=false and configure AWS credentials (sns:Publish).
# India also requires DLT-registered sender ID + approved SMS templates.
# Mock SMS (local): messages written to server/outbox/sms_log.jsonl
SNS_URGENT_TOPIC_ARN=arn:aws:sns:ap-south-1:000000000000:bin-urgent-sms

# ===== Bedrock (admin chatbot, match explain, protocol analyzer) =====
# Generate at: AWS Console → Amazon Bedrock → API keys → Generate long-term API key
# Paste the key below (shown once in the console). Do NOT commit the real value.
BEDROCK_API_KEY=
# boto3 also accepts this name directly if you prefer:
# AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=anthropic.claude-haiku-20240307-v1:0
BEDROCK_REGION=us-east-1
# Keep SNS/SES mocks on but use real Bedrock for /ai/* endpoints:
BEDROCK_USE_MOCKS=false

# ===== SageMaker =====
SAGEMAKER_ENDPOINT_NAME=bin-reliability-scorer-v1

# ===== Step Functions =====
STEP_FUNCTIONS_ARN=arn:aws:states:ap-south-1:000000000000:stateMachine:BinOrchestrator

# ===== DynamoDB Tables =====
DYNAMO_RESPONSE_TOKENS_TABLE=bin-response-tokens
DYNAMO_ACTIVE_REQUESTS_TABLE=bin-active-requests
DYNAMO_DONOR_AVAILABILITY_TABLE=bin-donor-availability
DYNAMO_METRICS_TABLE=bin-metrics

# ===== Frontend =====
ADMIN_FRONTEND_URL=http://localhost:5173
DONOR_PORTAL_URL=http://localhost:5174

# ===== CORS (optional extras — localhost + Amplify prod URL are always allowed in code) =====
# CORS_ORIGINS=

# API prefix is /api by default in code (see DEFAULT_API_PREFIX in app/config.py).
# API_PREFIX=
